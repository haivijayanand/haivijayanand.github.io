TOOL:    xfoil-6.99-instrumented.patch - instrumented XFOIL 6.99 builds used in the XFOIL-improvements paper
FAMILY:  technical-papers / xfoil-improvements-convergence-multielement
VERSION: 1.0.0
DATE:    2026-11-28
CHAT:    XFOIL improvements, history, branches and multi-element airfoils (2026-11-28)
CHANGES: 1.0.0 - HPREC full-precision CL/CD line; XF_TRUST relaxation switch (0 stock, 1 adaptive bound, 2 fixed [-0.4,1.0])
Apply in the src/ folder of the Debian xfoil 6.99.dfsg+1 source with: patch -p2 < xfoil-6.99-instrumented.patch

diff -u -x '*.o' xfoil-6.99.dfsg+1/src/xbl.f mod/src/xbl.f
--- xfoil-6.99.dfsg+1/src/xbl.f	2009-12-08 07:36:29.000000000 +0530
+++ mod/src/xbl.f	2026-11-28 08:39:44.999146562 +0530
@@ -1260,6 +1260,7 @@
 C        If LALFA=.FALSE., "AC" is alpha
 C------------------------------------------------------------------
       INCLUDE 'XFOIL.INC'
+      COMMON /TRUSTR/ TRF, RMSPRV, ITRUST
       REAL UNEW(IVX,2), U_AC(IVX,2)
       REAL QNEW(IQX),   Q_AC(IQX)
       EQUIVALENCE (VA(1,1,1), UNEW(1,1)) ,
@@ -1403,6 +1404,14 @@
 C
       DHI = 1.5
       DLO = -.5
+      IF(ITRUST.EQ.1) THEN
+       DHI = 1.5*TRF
+       DLO = -.5*TRF
+      ENDIF
+      IF(ITRUST.EQ.2) THEN
+       DHI = 1.0
+       DLO = -.4
+      ENDIF
 C
 C---- calculate changes in BL variables and under-relaxation if needed
       DO 4 IS=1, 2
@@ -1478,6 +1487,14 @@
 C
 C---- set true rms change
       RMSBL = SQRT( RMSBL / (4.0*FLOAT( NBL(1)+NBL(2) )) )
+      IF(ITRUST.EQ.1) THEN
+       IF(RMSBL .GT. 0.9*RMSPRV) THEN
+        TRF = MAX(0.2, 0.5*TRF)
+       ELSE
+        TRF = MIN(1.0, 1.6*TRF)
+       ENDIF
+       RMSPRV = RMSBL
+      ENDIF
 C
 C
       IF(LALFA) THEN
diff -u -x '*.o' xfoil-6.99.dfsg+1/src/xoper.f mod/src/xoper.f
--- xfoil-6.99.dfsg+1/src/xoper.f	2026-11-28 07:49:58.000000000 +0530
+++ mod/src/xoper.f	2026-11-28 08:39:45.003120696 +0530
@@ -2888,6 +2888,8 @@
 C     Converges viscous operating point
 C----------------------------------------
       INCLUDE 'XFOIL.INC'
+      COMMON /TRUSTR/ TRF, RMSPRV, ITRUST
+      CHARACTER*8 TRSTR
 C
 C---- convergence tolerance
       DATA EPS1 / 1.0E-4 /
@@ -2961,6 +2963,12 @@
       IF(NITER.EQ.0) CALL ASKI('Enter number of iterations^',NITER)
       WRITE(*,*)
       WRITE(*,*) 'Solving BL system ...'
+      CALL GET_ENVIRONMENT_VARIABLE('XF_TRUST',TRSTR)
+      ITRUST = 0
+      IF(TRSTR(1:1).EQ.'1') ITRUST = 1
+      IF(TRSTR(1:1).EQ.'2') ITRUST = 2
+      TRF = 1.0
+      RMSPRV = 1.0E30
       DO 1000 ITER=1, NITER
 C
 C------ fill Newton system for BL variables
@@ -3003,6 +3011,7 @@
      &   WRITE(*,2010) ITER, RMSBL, RMXBL, VMXBL,IMXBL,ISMXBL
          CDPDIF = CD - CDF
          WRITE(*,2020) ALFA/DTOR, CL, CM, CD, CDF, CDPDIF
+         WRITE(*,'(A,3ES23.15)') ' HPREC ', CL, CD, ALFA/DTOR
 c         CDSURF = CDP + CDF
 c         WRITE(*,2025) CDSURF, CDF, CDP
 
