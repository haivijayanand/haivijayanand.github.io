// TOOL: firestore.rules — Firestore security rules for site-progress (haivijayanand.github.io)
// FAMILY: site-progress
// VERSION: 1.0.0
// DATE: 2026-11-16
// CHAT: Login, progress & certificates on GitHub Pages with Firebase
// CHANGES: 1.0.0 — first release: each user reads/writes only their own data; public certificate records readable by ID only
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // users/{uid}, users/{uid}/progress/*, users/{uid}/certificates/* — owner only
    match /users/{uid} {
      allow read, write: if isOwner(uid);
      match /{sub=**} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && request.resource.data.size() <= 30;
      }
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // certificates/{certId} — public record used by /verify/
    match /certificates/{certId} {
      allow get: if true;            // anyone with the ID can check it
      allow list: if false;          // nobody can browse the list of certificates
      allow create: if validCert(certId);
      allow update: if validCert(certId) && resource.data.uid == request.auth.uid;
      allow delete: if false;
    }

    function validCert(certId) {
      let d = request.resource.data;
      return request.auth != null
        && d.uid == request.auth.uid
        && d.certId == certId
        && d.keys().hasOnly(['certId', 'uid', 'holderName', 'course', 'title', 'score', 'path', 'issuedAt'])
        && d.holderName is string && d.holderName.size() <= 80
        && d.title is string && d.title.size() <= 200
        && d.issuedAt == request.time;
    }
  }
}
